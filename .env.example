# Local development: no database installation required.
DATABASE_URL=sqlite:///./dear_future.sqlite3
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=45
APP_BASE_URL=http://127.0.0.1:8000
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=3600

# Recommended email delivery for Railway and other hosts.
MAIL_ENABLED=false
RESEND_API_KEY=
MAIL_FROM="DearFuture Slow Mail <hello@letters.yourdomain.com>"

# Optional SMTP fallback (Railway requires Pro for outbound SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
